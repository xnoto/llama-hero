# forge-proxy.container — Podman Quadlet unit for Forge guardrails proxy
#
# Placement (rootless):
#   ~/.config/containers/systemd/forge-proxy.container
#
# Generated service name: forge-proxy.service
#
# This service is additive: it does not change the llama-server model or flags.
# It exposes Forge on host port 8081 and forwards to the existing llama-server
# on host port 8080.

[Unit]
Description=Forge guardrails proxy for llama.cpp
After=network-online.target llama-server.service
Wants=network-online.target llama-server.service

[Container]
Image=localhost/forge-proxy:0.6.0

# Publish Forge on host port 8081. The proxy reaches the existing llama-server
# through Podman's host.containers.internal alias without changing the
# llama-server Quadlet.
PodmanArgs=--name forge-proxy \
  -p 8081:8081 \
  --health-cmd="curl -sf http://localhost:8081/health || exit 1" \
  --health-interval=30s \
  --health-timeout=10s \
  --health-retries=5 \
  --health-start-period=30s

Exec=python -m forge.proxy \
  --backend-url http://host.containers.internal:8080 \
  --host 0.0.0.0 \
  --port 8081 \
  --budget-mode backend \
  --serialize

[Service]
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
